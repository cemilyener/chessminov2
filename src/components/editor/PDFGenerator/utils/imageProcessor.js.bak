export const cleanBase64Image = async (base64String) => {
  if (!base64String || typeof base64String !== 'string') {
    return null;
  }
  
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0);
        resolve(canvas.toDataURL('image/png'));
      } catch (error) {
        console.error('Canvas error:', error);
        reject(error);
      }
    };
    img.onerror = () => reject(new Error('Image load failed'));
    img.src = base64String;
  });
};

/**
 * Creates a canvas from an image and returns a clean base64 string
 * @param {string} base64String - Base64 image string
 * @param {number} width - Optional width to resize to
 * @param {number} height - Optional height to resize to
 * @returns {Promise<string>} - Promise resolving to clean base64 string
 */
export const createCanvasFromImage = (base64String, width = 400, height = 400) => {
  return new Promise((resolve, reject) => {
    // Validate input
    const cleanedBase64 = cleanBase64String(base64String);
    if (!cleanedBase64) {
      console.debug('imageProcessor: Invalid input for canvas conversion');
      reject(new Error('Invalid base64 input'));
      return;
    }

    // Create image element
    const img = new Image();
    img.crossOrigin = 'Anonymous';
    
    // Set up load and error handlers
    img.onload = () => {
      try {
        // Create canvas with specified dimensions
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        
        // Use specified dimensions or maintain aspect ratio
        if (width && height) {
          canvas.width = width;
          canvas.height = height;
        } else {
          canvas.width = img.width;
          canvas.height = img.height;
        }

        // Render the image to canvas
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Calculate dimensions to maintain aspect ratio if needed
        const aspectRatio = img.width / img.height;
        let drawWidth = canvas.width;
        let drawHeight = canvas.height;
        
        if (width && height) {
          // Center and scale the image to fit the canvas
          if (img.width / img.height > aspectRatio) {
            drawHeight = canvas.width / aspectRatio;
            ctx.drawImage(img, 0, (canvas.height - drawHeight) / 2, canvas.width, drawHeight);
          } else {
            drawWidth = canvas.height * aspectRatio;
            ctx.drawImage(img, (canvas.width - drawWidth) / 2, 0, drawWidth, canvas.height);
          }
        } else {
          // Use original dimensions
          ctx.drawImage(img, 0, 0);
        }

        // Get as PNG (more reliable than JPEG for PDF)
        const cleanBase64 = canvas.toDataURL('image/png');
        resolve(cleanBase64);
      } catch (error) {
        console.error('imageProcessor: Canvas processing error:', error);
        reject(error);
      }
    };

    img.onerror = (error) => {
      console.error('imageProcessor: Image loading failed:', error);
      reject(new Error('Failed to load image'));
    };

    // Trigger image loading
    img.src = cleanedBase64;
  });
};

/**
 * Process a chessboard image specifically for PDF rendering
 * @param {string} boardImageBase64 - The chessboard image as base64
 * @returns {Promise<string>} - Processed image as base64
 */
export const processChessboardImage = async (boardImageBase64) => {
  try {
    // Fixed dimensions for consistency in PDFs
    const width = 400; 
    const height = 400;
    
    // Enhanced debugging
    console.debug('imageProcessor: Starting processing of chessboard image');
    console.debug(`imageProcessor: Input type: ${typeof boardImageBase64}`);
    console.debug(`imageProcessor: Input starts with: ${boardImageBase64?.substring(0, 20)}...`);
    console.debug(`imageProcessor: Input length: ${boardImageBase64?.length || 0}`);
    
    if (!boardImageBase64) {
      console.warn('imageProcessor: Empty or null input received');
      return createPlaceholderImage();
    }
    
    // Use canvas method to clean and standardize the image
    const processedImage = await createCanvasFromImage(boardImageBase64, width, height);
    
    if (!processedImage) {
      console.warn('imageProcessor: Canvas processing returned empty result');
      return createPlaceholderImage();
    }
    
    console.debug('imageProcessor: Successfully processed chessboard image');
    console.debug(`imageProcessor: Output starts with: ${processedImage.substring(0, 20)}...`);
    console.debug(`imageProcessor: Output length: ${processedImage.length}`);
    
    return processedImage;
  } catch (error) {
    console.error('imageProcessor: Chessboard processing failed:', error);
    // Return placeholder image instead of empty string
    return createPlaceholderImage();
  }
};

/**
 * Creates a placeholder image when processing fails
 * @returns {string} - Base64 string of a simple placeholder image
 */
export const createPlaceholderImage = () => {
  try {
    // Create a canvas for the placeholder
    const canvas = document.createElement('canvas');
    canvas.width = 400;
    canvas.height = 400;
    const ctx = canvas.getContext('2d');
    
    // Fill with light gray
    ctx.fillStyle = '#F0F0F0';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Draw a border
    ctx.strokeStyle = '#AAAAAA';
    ctx.lineWidth = 2;
    ctx.strokeRect(5, 5, canvas.width - 10, canvas.height - 10);
    
    // Add text
    ctx.fillStyle = '#888888';
    ctx.font = 'bold 24px Arial';
    ctx.textAlign = 'center';
    ctx.fillText('Görüntü Yüklenemedi', canvas.width / 2, canvas.height / 2);
    
    return canvas.toDataURL('image/png');
  } catch (error) {
    console.error('imageProcessor: Failed to create placeholder:', error);
    // Return minimal valid data URI if everything fails
    return 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=';
  }
};

/**
 * Batch processes multiple chess board images
 * @param {Array<string>} imageArray - Array of base64 image strings
 * @returns {Promise<Array<string>>} - Array of processed images
 */
export const batchProcessImages = async (imageArray) => {
  if (!Array.isArray(imageArray) || imageArray.length === 0) {
    return [];
  }

  try {
    // Process all images in parallel
    const processedResults = await Promise.all(
      imageArray.map(async (base64String) => {
        try {
          return await processChessboardImage(base64String);
        } catch (err) {
          console.error('imageProcessor: Failed to process image in batch:', err);
          return createPlaceholderImage();
        }
      })
    );
    
    // Filter out any empty results
    return processedResults.filter(img => img && typeof img === 'string');
  } catch (error) {
    console.error('imageProcessor: Batch processing failed:', error);
    return [];
  }
};
